## 📋 Full Router Configurations

### R1 (Site C)
```
hostname R1

ip dhcp excluded-address 192.168.3.129 192.168.3.140
ip dhcp excluded-address 192.168.3.1 192.168.3.115

ip dhcp pool VLAN-SITE-C-COA_POOL
 network 192.168.3.128 255.255.255.192
 default-router 192.168.3.129
 dns-server 8.8.8.8
 domain-name SITEC-COAPOOL.COM

ip dhcp pool VLAN-SITE-C-TSS_POOL
 network 192.168.3.0 255.255.255.128
 default-router 192.168.3.1
 dns-server 8.8.8.8
 domain-name VLANSITE-C-TSS_POOL.COM

interface FastEthernet0/0
 ip address 10.0.12.1 255.255.255.252
 duplex auto
 speed auto

interface FastEthernet0/1
 ip address 10.0.13.1 255.255.255.252
 duplex auto
 speed auto

interface Ethernet1/0
 no ip address
 duplex auto
 speed auto

interface Ethernet1/0.50
 description VLAN-SITE-C-COA-Management
 encapsulation dot1Q 50
 ip address 192.168.3.129 255.255.255.192
 ip nat inside

interface Ethernet1/0.60
 description VLAN-SITE-C-TSS-Management
 encapsulation dot1Q 60
 ip address 192.168.3.1 255.255.255.128
 ip nat inside

router ospf 1
 log-adjacency-changes
 network 10.0.13.0 0.0.0.3 area 0
 network 10.0.12.0 0.0.0.3 area 0
 network 192.168.3.128 0.0.0.63 area 0
 network 192.168.3.0 0.0.0.127 area 0
```

