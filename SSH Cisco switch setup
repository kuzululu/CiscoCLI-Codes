Assumption:

Core/L3 Switch = 192.168.99.1
Access Switch = 192.168.99.2
VLAN 10 = Users
VLAN 20 = Users
VLAN 99 = Management
Trunk = Gi1/0/24
Access ports = Gi1/0/1-23
DHCP nasa Core Switch
SSH sa Core at Access Switch

CORE / L3 SWITCH
enable
configure terminal

hostname CORE-SW

! =========================
! VLAN CONFIGURATION
! =========================
vlan 10
 name USERS_VLAN10
exit

vlan 20
 name USERS_VLAN20
exit

vlan 99
 name MANAGEMENT
exit

! =========================
! SVI / GATEWAY
! =========================
interface vlan 10
 description VLAN10-GATEWAY
 ip address 192.168.10.1 255.255.255.0
 no shutdown
exit

interface vlan 20
 description VLAN20-GATEWAY
 ip address 192.168.20.1 255.255.255.0
 no shutdown
exit

interface vlan 99
 description MANAGEMENT
 ip address 192.168.99.1 255.255.255.0
 no shutdown
exit

! =========================
! DHCP VLAN 10
! =========================
ip dhcp excluded-address 192.168.10.1 192.168.10.20

ip dhcp pool VLAN10
 network 192.168.10.0 255.255.255.0
 default-router 192.168.10.1
 dns-server 8.8.8.8
exit

! =========================
! DHCP VLAN 20
! =========================
ip dhcp excluded-address 192.168.20.1 192.168.20.20

ip dhcp pool VLAN20
 network 192.168.20.0 255.255.255.0
 default-router 192.168.20.1
 dns-server 8.8.8.8
exit

! =========================
! ENABLE L3 ROUTING
! =========================
ip routing

! =========================
! TRUNK TO ACCESS SWITCH
! =========================
interface GigabitEthernet1/0/24
 description TRUNK-TO-ACCESS-SW
 switchport mode trunk
 switchport trunk allowed vlan 10,20,99
 no shutdown
exit

! =========================
! SSH
! =========================
ip domain-name network.local

username admin privilege 15 secret Cisco123!

crypto key generate rsa modulus 2048

ip ssh version 2

line vty 0 15
 login local
 transport input ssh
exit

end

write memory

ACCESS SWITCH

Ito naman ang buong config ng Access Switch:

enable
configure terminal

hostname ACCESS-SW1

! =========================
! VLAN CONFIGURATION
! =========================
vlan 10
 name USERS_VLAN10
exit

vlan 20
 name USERS_VLAN20
exit

vlan 99
 name MANAGEMENT
exit

! =========================
! MANAGEMENT SVI
! =========================
interface vlan 99
 description SWITCH-MANAGEMENT
 ip address 192.168.99.2 255.255.255.0
 no shutdown
exit

! =========================
! DEFAULT GATEWAY
! =========================
ip default-gateway 192.168.99.1

! =========================
! TRUNK TO CORE
! =========================
interface GigabitEthernet1/0/24
 description TRUNK-TO-CORE-SW
 switchport mode trunk
 switchport trunk allowed vlan 10,20,99
 no shutdown
exit

! =========================
! VLAN 10 ACCESS PORTS
! =========================
interface range GigabitEthernet1/0/1-12
 description VLAN10-USERS
 switchport mode access
 switchport access vlan 10
 spanning-tree portfast
 no shutdown
exit

! =========================
! VLAN 20 ACCESS PORTS
! =========================
interface range GigabitEthernet1/0/13-23
 description VLAN20-USERS
 switchport mode access
 switchport access vlan 20
 spanning-tree portfast
 no shutdown
exit

! =========================
! SSH
! =========================
ip domain-name network.local

username admin privilege 15 secret Cisco123!

crypto key generate rsa modulus 2048

ip ssh version 2

line vty 0 15
 login local
 transport input ssh
exit

end

write memory
